# Copy this file to .env and fill in real values.
# NEVER commit .env to git.

# --- MongoDB Atlas ---
MONGODB_URI=mongodb+srv://<db_username>:<db_password>@<cluster-host>/?retryWrites=true&w=majority&appName=Cluster0
MONGODB_DB_NAME=taskflow

# --- Firebase Admin (from the service-account JSON) ---
FIREBASE_PROJECT_ID=your-project-id
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-project-id.iam.gserviceaccount.com
# Paste the private_key exactly as it is in the JSON (with \n), wrapped in double quotes.
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nREPLACE_ME\n-----END PRIVATE KEY-----\n"

# --- Optional ---
# Allowed CORS origin(s), comma separated. Native Android apps don't need CORS; "*" is fine.
CORS_ORIGIN=*
# Port for `npm run dev` (local Express server)
PORT=3000
